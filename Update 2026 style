/* ============================================================
   CRATES O COMICS — "Printed Comic" visual system
   Halftone textures, ink-hard shadows, CMYK accents per issue
   ============================================================ */

/* --- VARIABLES & RESET --- */
:root {
  --ink: #0d0a16;            /* near-black ink */
  --ink-2: #151123;          /* panel ink */
  --paper: #fff6e3;          /* newsprint cream */
  --yellow: #ffd23f;         /* classic comic yellow */
  --cyan: #2ec5f6;           /* process cyan */
  --magenta: #ff2e63;        /* process magenta */
  --orange: #ff8c2e;         /* solar orange */
  --text: #f4f1ff;
  --muted: rgba(244, 241, 255, 0.72);

  --font-header: 'Bangers', cursive;
  --font-body: 'Karla', 'Roboto', sans-serif;
}

* { box-sizing: border-box; }

html, body {
  margin: 0;
  padding: 0;
  font-family: var(--font-body);
  color: var(--text);
  background-color: var(--ink);
  overflow: hidden; /* single scrollbar — snap container scrolls */
  height: 100%;
}

::selection { background: var(--yellow); color: #000; }

/* --- SCROLL SNAP LAYOUT --- */
.snap-container {
  scroll-snap-type: y mandatory;
  overflow-y: scroll;
  height: 100vh;
  scroll-behavior: smooth;
}

.snap-section {
  scroll-snap-align: start;
  height: 100vh;
  width: 100%;
  position: relative;
  overflow: hidden;
  display: flex;
  justify-content: center;
  align-items: center;
}

/* Halftone dot texture — the signature print finish on every section */
.snap-section::before {
  content: "";
  position: absolute;
  inset: 0;
  background-image: radial-gradient(circle, rgba(255, 255, 255, 0.05) 1.2px, transparent 1.4px);
  background-size: 16px 16px;
  pointer-events: none;
  z-index: 1;
}

.snap-section > * { position: relative; z-index: 2; }

/* --- TYPOGRAPHY --- */
h1, h2, h3, .book-title, .section-title {
  font-family: var(--font-header);
  letter-spacing: 2px;
}

p {
  line-height: 1.65;
  font-size: 1.1rem;
}

/* Comic caption box — yellow strip with ink border */
.caption-box {
  display: inline-block;
  background: var(--yellow);
  color: #000;
  font-family: var(--font-header);
  font-size: 1.15rem;
  letter-spacing: 3px;
  padding: 6px 18px 4px;
  border: 3px solid #000;
  box-shadow: 5px 5px 0 rgba(0, 0, 0, 0.85);
  transform: rotate(-1.5deg);
  text-transform: uppercase;
}

/* Issue eyebrow — these books really are issues in a sequence */
.issue-tag {
  display: inline-block;
  font-family: var(--font-header);
  font-size: 1rem;
  letter-spacing: 4px;
  color: #000;
  background: var(--accent, var(--yellow));
  border: 3px solid #000;
  padding: 4px 14px 2px;
  margin-bottom: 14px;
  box-shadow: 4px 4px 0 rgba(0, 0, 0, 0.85);
  transform: rotate(-2deg);
}

/* ============================================================
   HERO
   ============================================================ */
#Hero {
  flex-direction: column;
  background:
    radial-gradient(ellipse at 50% 120%, rgba(255, 210, 63, 0.14), transparent 55%),
    radial-gradient(ellipse at 15% 10%, rgba(46, 197, 246, 0.12), transparent 50%),
    radial-gradient(ellipse at 85% 15%, rgba(255, 46, 99, 0.10), transparent 50%),
    var(--ink);
}

/* dense halftone fade rising from the bottom of the hero */
#Hero::after {
  content: "";
  position: absolute;
  left: 0; right: 0; bottom: 0;
  height: 45%;
  background-image: radial-gradient(circle, rgba(255, 210, 63, 0.22) 1.5px, transparent 1.7px);
  background-size: 14px 14px;
  -webkit-mask-image: linear-gradient(to top, black, transparent);
          mask-image: linear-gradient(to top, black, transparent);
  pointer-events: none;
  z-index: 1;
}

.hero-wrap { position: relative; overflow: hidden; }

.content-wrap {
  z-index: 10;
  position: relative;
  text-align: center;
}

.hero-title-row {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  flex-wrap: wrap;
  margin-bottom: 28px;
}

.hero-word {
  font-size: clamp(4rem, 11vw, 9rem);
  margin: 0;
  line-height: 1;
  color: var(--yellow);
  -webkit-text-stroke: 3px #000;
  text-shadow:
    4px 4px 0 #000,
    8px 8px 0 var(--magenta),
    12px 12px 0 rgba(46, 197, 246, 0.55); /* CMYK mis-registration layers */
  animation: heroSlam 0.7s cubic-bezier(0.2, 1.4, 0.4, 1) both;
}

.hero-word:last-of-type { animation-delay: 0.12s; }

@keyframes heroSlam {
  from { opacity: 0; transform: scale(1.6); }
  to   { opacity: 1; transform: scale(1); }
}

/* Starburst behind the logo "O" */
.parallax-wrapper {
  position: relative;
  width: 200px;
  height: 200px;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 50%;
  border: 8px solid #000;
  background-color: var(--yellow);
  box-shadow: 0 0 0 6px var(--yellow), 8px 14px 0 rgba(0, 0, 0, 0.8);
  margin: 0 36px;
  z-index: 20;
  animation: heroSlam 0.7s 0.06s cubic-bezier(0.2, 1.4, 0.4, 1) both;
}

.parallax-wrapper::before {
  content: "";
  position: absolute;
  inset: -70px;
  border-radius: 50%;
  background: repeating-conic-gradient(
    from 0deg,
    rgba(255, 210, 63, 0.35) 0deg 7deg,
    transparent 7deg 16deg
  );
  z-index: -1;
  animation: spinRays 40s linear infinite;
  pointer-events: none;
}

@keyframes spinRays {
  to { transform: rotate(360deg); }
}

.hero-logo {
  width: 78%;
  height: auto;
  z-index: 10;
  filter: drop-shadow(0 4px 6px rgba(0, 0, 0, 0.6));
  transform: rotate(-8deg);
  transition: transform 0.3s;
}

.parallax-wrapper:hover .hero-logo { transform: rotate(0deg) scale(1.06); }

.hero-sub {
  font-size: clamp(2rem, 4vw, 3.2rem);
  margin: 0 0 22px;
  color: #fff;
  -webkit-text-stroke: 2px #000;
  text-shadow: 4px 4px 0 #000;
  animation: heroSlam 0.7s 0.22s cubic-bezier(0.2, 1.4, 0.4, 1) both;
}

.hero-byline {
  animation: heroSlam 0.7s 0.34s cubic-bezier(0.2, 1.4, 0.4, 1) both;
}

.scroll-indicator {
  position: absolute;
  bottom: 22px;
  left: 50%;
  transform: translateX(-50%);
  animation: bounce 2s infinite;
  opacity: 0.85;
  z-index: 10;
  font-family: var(--font-header);
  letter-spacing: 3px;
  color: var(--yellow);
  text-shadow: 2px 2px 0 #000;
  font-size: 1.1rem;
  text-align: center;
}

@keyframes bounce {
  0%, 20%, 50%, 80%, 100% { transform: translateX(-50%) translateY(0); }
  40% { transform: translateX(-50%) translateY(-10px); }
  60% { transform: translateX(-50%) translateY(-5px); }
}

/* Floating parallax bubbles — now halftone-flavored */
.parallax-layer {
  position: absolute;
  border-radius: 50%;
  z-index: 1;
  pointer-events: none;
  filter: blur(1.5px);
  background-image: radial-gradient(circle, rgba(0, 0, 0, 0.25) 1.5px, transparent 1.7px) !important;
  background-size: 8px 8px !important;
  border: 2px solid rgba(255, 255, 255, 0.08);
}

/* ============================================================
   BOOK SECTIONS — each issue is its own printed panel
   ============================================================ */
.book-section { background-color: var(--ink); }

/* per-issue accent theming */
#Standalone1   { --accent: var(--yellow); }
#Standalone2   { --accent: var(--cyan); }
#Section4      { --accent: var(--orange); }
#Ended-Section { --accent: var(--magenta); }

/* big soft glow of the issue's accent color behind the cover */
.book-section::after {
  content: "";
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse at 72% 50%, color-mix(in srgb, var(--accent, var(--yellow)) 16%, transparent), transparent 55%);
  pointer-events: none;
  z-index: 1;
}

.book-display-wrapper {
  display: flex;
  width: 86%;
  max-width: 1200px;
  justify-content: space-between;
  align-items: center;
  gap: 3rem;
  transition: opacity 0.5s ease;
}

.book-info {
  flex: 1;
  max-width: 540px;
}

.book-title {
  font-size: clamp(3rem, 6vw, 5rem);
  margin: 0 0 1.2rem;
  line-height: 0.95;
  color: var(--accent, var(--yellow));
  -webkit-text-stroke: 2px #000;
  text-shadow: 4px 4px 0 #000, 7px 7px 0 color-mix(in srgb, var(--accent, var(--yellow)) 40%, transparent);
}

.book-desc {
  margin-bottom: 1.8rem;
  font-size: 1.15rem;
  color: var(--muted);
  max-width: 480px;
}

.release-tag {
  display: inline-block;
  color: #000;
  background: #fff;
  font-family: var(--font-header);
  letter-spacing: 2px;
  font-size: 1.25rem;
  border: 3px solid #000;
  padding: 6px 16px 4px;
  margin: 0 0 1.6rem;
  box-shadow: 5px 5px 0 var(--accent, var(--yellow));
  transform: rotate(-1.2deg);
}

/* --- Buttons: inked, with hard offset shadows --- */
.btn-preview, .btn-purchase {
  padding: 12px 26px 10px;
  font-family: var(--font-header);
  font-size: 1.4rem;
  letter-spacing: 2px;
  border: 3px solid #000;
  cursor: pointer;
  transition: transform 0.15s, box-shadow 0.15s;
  margin: 0 12px 12px 0;
  box-shadow: 5px 5px 0 #000;
}

.btn-preview { background-color: #fff; color: #000; }
.btn-purchase { background-color: var(--accent, var(--yellow)); color: #000; }

.btn-preview:hover, .btn-purchase:hover {
  transform: translate(-2px, -2px);
  box-shadow: 8px 8px 0 #000;
}

.btn-preview:active, .btn-purchase:active {
  transform: translate(3px, 3px);
  box-shadow: 2px 2px 0 #000;
}

.btn-preview:focus-visible, .btn-purchase:focus-visible,
.submit-btn:focus-visible, .nav-link:focus-visible {
  outline: 3px dashed var(--yellow);
  outline-offset: 3px;
}

.btn-soon {
  opacity: 0.55;
  cursor: default;
}
.btn-soon:hover { transform: none; box-shadow: 5px 5px 0 #000; }

/* --- Cover framed like a printed comic panel --- */
.book-cover {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  cursor: pointer;
}

.cover-frame {
  position: relative;
  transform: rotate(2.5deg);
  transition: transform 0.35s cubic-bezier(0.2, 1.2, 0.4, 1);
}

.book-cover:hover .cover-frame {
  transform: rotate(0deg) translateY(-8px);
}

/* halftone burst peeking out behind the cover */
.cover-frame::before {
  content: "";
  position: absolute;
  inset: -34px;
  background-image: radial-gradient(circle, color-mix(in srgb, var(--accent, var(--yellow)) 60%, transparent) 2px, transparent 2.3px);
  background-size: 12px 12px;
  border-radius: 50%;
  z-index: -1;
  opacity: 0.5;
  transition: opacity 0.35s, transform 0.35s;
}

.book-cover:hover .cover-frame::before {
  opacity: 0.9;
  transform: scale(1.04);
}

.cover-img {
  display: block;
  max-height: 64vh;
  max-width: 100%;
  border: 5px solid #fff;
  outline: 4px solid #000;
  box-shadow: 14px 14px 0 color-mix(in srgb, var(--accent, var(--yellow)) 85%, black 10%);
  transition: box-shadow 0.35s;
}

.book-cover:hover .cover-img {
  box-shadow: 18px 18px 0 var(--accent, var(--yellow));
}

.tap-hint {
  margin-top: 26px;
  font-family: var(--font-header);
  font-size: 1.15rem;
  letter-spacing: 2px;
  color: var(--accent, var(--yellow));
  text-shadow: 2px 2px 0 #000;
  opacity: 0.85;
  transition: opacity 0.3s, transform 0.3s;
}

.book-cover:hover .tap-hint { opacity: 1; transform: translateY(-2px); }

/* --- Scroll reveal --- */
.reveal {
  opacity: 0;
  transform: translateY(40px);
  transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.2, 1, 0.4, 1);
}
.reveal.delay-1 { transition-delay: 0.12s; }
.reveal.delay-2 { transition-delay: 0.24s; }

.in-view .reveal {
  opacity: 1;
  transform: translateY(0);
}

/* ============================================================
   FLIPBOOK OVERLAY (Turn.js)
   ============================================================ */
.flipbook-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
  background:
    radial-gradient(circle, rgba(255, 255, 255, 0.04) 1.2px, transparent 1.4px) 0 0 / 16px 16px,
    rgba(5, 4, 10, 0.97);
  z-index: 100;
  justify-content: center;
  align-items: center;
  padding: 0;
}

.flipbook {
  box-shadow: 0 30px 80px rgba(0, 0, 0, 0.8), 0 0 0 4px rgba(255, 255, 255, 0.08);
}

.flipbook .page {
  overflow: hidden;
  background-color: white;
}

.flipbook .page img {
  width: 100%;
  height: 100%;
  object-fit: fill;
  display: block;
  user-select: none;
  -webkit-user-drag: none;
}

.exit-button {
  position: fixed;
  top: 20px;
  right: 30px;
  background: var(--magenta);
  color: white;
  border: 3px solid #000;
  font-family: var(--font-header);
  letter-spacing: 2px;
  font-size: 1.1rem;
  padding: 10px 20px 8px;
  z-index: 200;
  cursor: pointer;
  box-shadow: 4px 4px 0 #000;
  transition: transform 0.15s, box-shadow 0.15s;
}

.exit-button:hover {
  transform: translate(-2px, -2px);
  box-shadow: 6px 6px 0 #000;
}

/* ============================================================
   NAVIGATION — caption tabs along the right edge
   ============================================================ */
#navbar {
  position: fixed;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6px;
  z-index: 50;
  transition: right 0.4s ease;
}

.nav-link {
  color: rgba(255, 255, 255, 0.55);
  background: rgba(13, 10, 22, 0.85);
  border: 2px solid rgba(255, 255, 255, 0.12);
  border-right: none;
  text-align: right;
  padding: 7px 18px 5px 16px;
  text-decoration: none;
  font-family: var(--font-header);
  font-size: 1.05rem;
  letter-spacing: 2px;
  transition: 0.25s;
}

.nav-link:hover, .nav-link.active {
  color: #000;
  background: var(--yellow);
  border-color: #000;
  padding-right: 28px;
  text-decoration: none;
}

.hamburger-menu { display: none; }

/* ============================================================
   ABOUT
   ============================================================ */
#AboutMe {
  background:
    radial-gradient(ellipse at 80% 20%, rgba(46, 197, 246, 0.12), transparent 55%),
    var(--ink-2);
}

.section-title {
  font-size: clamp(2.6rem, 5vw, 4rem);
  color: var(--yellow);
  -webkit-text-stroke: 2px #000;
  text-shadow: 4px 4px 0 #000;
}

.about-description p {
  font-size: 1.25rem;
  color: var(--muted);
  margin-bottom: 1.4rem;
  line-height: 1.8;
}

.about-description em {
  color: var(--yellow);
  font-style: normal;
  font-weight: 700;
}

.profile-wrapper {
  position: relative;
  padding: 10px;
  display: inline-block;
}

/* halftone burst behind the profile art */
.profile-wrapper::before {
  content: "";
  position: absolute;
  inset: -26px;
  background-image: radial-gradient(circle, rgba(46, 197, 246, 0.5) 2px, transparent 2.3px);
  background-size: 12px 12px;
  border-radius: 50%;
  z-index: -1;
  opacity: 0.45;
}

.profile-img {
  max-width: 100%;
  max-height: 58vh;
  border: 5px solid #fff;
  outline: 4px solid #000;
  box-shadow: 14px 14px 0 var(--cyan);
  transform: rotate(2deg);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.profile-img:hover {
  transform: rotate(0deg) scale(1.02);
}

/* ============================================================
   CONTACT — the form is a speech bubble
   ============================================================ */
#Contact {
  background:
    radial-gradient(ellipse at 50% -10%, rgba(255, 46, 99, 0.12), transparent 55%),
    var(--ink);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.contact-wrapper {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-top: 50px;
}

.contact-intro {
  color: var(--muted);
  margin-bottom: 36px;
  font-size: 1.15rem;
}

#contact-form {
  position: relative;
  background-color: var(--paper);
  padding: 2.2rem;
  border: 4px solid #000;
  border-radius: 26px;
  box-shadow: 10px 10px 0 rgba(0, 0, 0, 0.8);
  max-width: 620px;
  margin: 0 auto;
  width: 100%;
}

/* speech-bubble tail */
#contact-form::after {
  content: "";
  position: absolute;
  bottom: -26px;
  left: 70px;
  width: 0;
  height: 0;
  border-left: 14px solid transparent;
  border-right: 26px solid transparent;
  border-top: 30px solid var(--paper);
  filter: drop-shadow(4px 5px 0 rgba(0, 0, 0, 0.9));
}

.form-group {
  margin-bottom: 1.4rem;
  text-align: left;
}

.form-group label {
  display: block;
  margin-bottom: 0.45rem;
  font-family: var(--font-header);
  color: #000;
  letter-spacing: 2px;
  font-size: 1.2rem;
}

.comic-input {
  width: 100%;
  padding: 12px;
  background-color: #fff;
  border: 3px solid #000;
  border-radius: 6px;
  font-family: var(--font-body);
  font-size: 1rem;
  color: #000;
  transition: 0.25s;
}

.comic-input:focus {
  outline: none;
  border-color: var(--magenta);
  box-shadow: 4px 4px 0 var(--yellow);
  transform: translate(-2px, -2px);
}

.submit-btn {
  width: 100%;
  font-size: 1.5rem;
  margin-top: 6px;
  background-color: var(--yellow);
}

/* --- FOOTER --- */
.site-footer {
  width: 100%;
  padding: 22px 0;
  background-color: rgba(0, 0, 0, 0.4);
  border-top: 3px solid rgba(255, 210, 63, 0.25);
  text-align: center;
  margin-top: auto;
}

.footer-content p {
  color: rgba(255, 255, 255, 0.55);
  font-size: 0.95rem;
  margin: 0 0 10px 0;
}

.social-links a {
  color: var(--yellow);
  margin: 0 10px;
  text-decoration: none;
  font-family: var(--font-header);
  letter-spacing: 2px;
  font-size: 1.1rem;
  transition: 0.25s;
}

.social-links a:hover {
  color: #fff;
  text-shadow: 0 0 12px var(--yellow);
}

/* --- BACK TO TOP --- */
.back-to-top {
  position: fixed;
  bottom: 30px;
  right: 30px;
  width: 54px;
  height: 54px;
  background-color: var(--yellow);
  color: #000;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  text-decoration: none;
  font-size: 26px;
  font-weight: bold;
  border: 3px solid #000;
  box-shadow: 4px 4px 0 #000;
  z-index: 60;
  transition: transform 0.2s, box-shadow 0.2s;
}

.back-to-top:hover {
  transform: translate(-2px, -4px);
  box-shadow: 7px 8px 0 #000;
  color: #000;
  text-decoration: none;
}

/* ============================================================
   RESPONSIVE
   ============================================================ */
@media (max-width: 900px) {
  .book-display-wrapper {
    flex-direction: column-reverse;
    width: 92%;
    text-align: center;
    gap: 1.2rem;
  }
  .book-info { max-width: 100%; }
  .book-desc { margin-left: auto; margin-right: auto; }
  .cover-img { max-height: 42vh; }
  .tap-hint { margin-top: 20px; }

  .hero-title-row { flex-direction: column; gap: 18px; }
  .parallax-wrapper {
    width: 150px;
    height: 150px;
    border-width: 6px;
    margin: 10px 0;
  }
  .parallax-wrapper::before { inset: -50px; }

  /* nav becomes a slide-in panel toggled by hamburger */
  #navbar {
    right: -100vw;
    top: 0;
    transform: none;
    height: 100vh;
    justify-content: center;
    background: rgba(13, 10, 22, 0.96);
    padding: 0 0 0 24px;
    border-left: 4px solid var(--yellow);
    width: 70vw;
    max-width: 300px;
  }
  .nav-link { font-size: 1.4rem; border: none; background: none; color: rgba(255,255,255,0.7); }
  .nav-link:hover, .nav-link.active { background: var(--yellow); color: #000; }

  .hamburger-menu {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    position: fixed;
    top: 18px;
    right: 18px;
    width: 50px;
    height: 50px;
    padding: 11px;
    background: var(--yellow);
    border: 3px solid #000;
    box-shadow: 4px 4px 0 #000;
    cursor: pointer;
    z-index: 60;
  }
  .hamburger-menu span {
    display: block;
    height: 3px;
    width: 100%;
    background: #000;
    border-radius: 2px;
  }
}

@media (max-width: 768px) {
  #AboutMe .row {
    flex-direction: column-reverse;
    text-align: center;
  }
  .profile-img {
    max-height: 38vh;
    margin-bottom: 26px;
  }
}

@media (max-width: 600px) {
  #contact-form {
    padding: 1.5rem;
    width: 92%;
  }
  .hero-word { -webkit-text-stroke: 2px black; }
}

/* short screens: keep book layout from clipping */
@media (max-height: 700px) and (min-width: 901px) {
  .cover-img { max-height: 56vh; }
  .book-title { font-size: 3.2rem; }
}

/* ============================================================
   REDUCED MOTION
   ============================================================ */
@media (prefers-reduced-motion: reduce) {
  .hero-word, .hero-sub, .hero-byline, .parallax-wrapper { animation: none; }
  .parallax-wrapper::before { animation: none; }
